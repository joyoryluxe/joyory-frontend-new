<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── SEO Sitemaps & Robots ────────────────────────────────────────────────
  # If sitemap files or static assets exist, serve them directly without routing to React
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect legacy or backend robots/sitemaps if not found locally
  RewriteRule ^robots\.txt$ https://beauty.joyory.com/robots.txt [R=301,L]

  # ─── React SPA Routing ───────────────────────────────────────────────────
  # Otherwise, route everything else to index.html for React Router
  RewriteRule ^ /index.html [L]
</IfModule>
